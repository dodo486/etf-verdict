{
 "_note": "구간③ 자동/직접 판정의 단일 진실(SSOT). 사람이 source 를 자유 판단하지 않는다 — 지표(metric.type)만 선언하면 여기서 자동가능 여부가 파생된다. verify_auto_coverage.py 가 이 레지스트리로 data_spec 을 검사한다.",
 "_semantics_note": "지표 무관 커버리지 엔진(verify_metric_semantics)의 입력. 지표마다 검사 로직을 손으로 짜지 않는다 — 모든 지표가 같은 스키마를 채운다: ①aspects=내가 계산하는 조건 축(거래량·종가위치·이동평균…) ②axes=규칙이 고르는 파라미터(기준선·기간)와 근거토큰. 엔진은 저자 라벨을 aspect_lexicon 으로 분해해, 저자가 말한 aspect 를 지표가 다 덮는지(누락) + 지표가 쓰는 축이 저자 소절에 있는지(창작)를 전 지표 동일 로직으로 대조한다. 새 지표=aspects 한 줄, 새 조건축=aspect_lexicon 한 줄.",

 "aspect_lexicon": {
  "_note": "저자 라벨/소절에서 '조건 축(aspect)'을 탐지하는 공용 어휘. 지표별로 흩어진 ground 단어를 여기 하나로 모은다. 정규화(공백제거) 후 부분일치.",
  "volume": ["거래량"],
  "close_pos": ["윗꼬리", "종가고점", "고점아래", "고점근처", "고점대비종가", "위에서털림", "종가밀림", "종가위치"],
  "ma": ["일선", "이동평균", "일평균", "거래일평균"],
  "return": ["수익률", "급등", "급락"],
  "gap": ["갭상승", "갭"],
  "breadth": ["개이상", "개중", "동반상승", "같은방향"],
  "pullback": ["눌림"],
  "resume": ["반등", "다시올라", "되돌", "올라오"],
  "breakout": ["전고점", "돌파"],
  "streak_days": ["연속"],
  "low_break": ["전일저점", "저점이탈", "저점을낮"]
 },
 "aspect_metric": {
  "_note": "누락된 aspect 를 자동 보강(compose)할 때 쓰는 기본 계산기. 데이터가 구해지는 aspect 만 등록(그래야 ✋로 안 빠지고 수집).",
  "close_pos": "upper_wick"
 },
 "must_cover_aspects": {
  "_note": "저자가 말하면 계산기가 반드시 덮어야 하는 '독립 조건' 축. 여기 없는 축(return·streak_days·breakout·pullback)은 수식어로 자주 붙어(급등 후·연속·전고점 근처·첫 눌림) 오탐을 내므로 누락 판정에서 뺀다. 판정은 절(clause) 단위: 한 절의 must-cover 축을 계산기가 하나도 안 덮으면 그 절은 방치된 것.",
  "list": ["volume", "close_pos", "resume", "ma", "gap", "low_break", "breadth"],
  "clause_split": ["+", "·", "그리고", "늘었는데", "는데", "끝", ","]
 },

 "auto_types": {
  "_note": "jhts 시세수집팀이 데이터를 주는 지표들. impl=true 면 엔진 계산까지 구현됨(🤖 자동), false 면 데이터는 있으나 판정 로직 미구현(🚧). aspects=이 계산기가 덮는 조건 축(엔진이 커버리지 대조에 씀).",

  "pct_change": {"data": "eod_close", "impl": true, "aspects": ["return"],
   "computes": "전일 대비 등락률(%)", "label": "{symbol} {value:+.2f}%"},
  "point_change": {"data": "eod_close", "impl": true, "aspects": ["return"],
   "computes": "전일 대비 절대 포인트 변화(%p)", "label": "{symbol} {value:+.2f}%p"},
  "n_day_return": {"data": "eod_close", "impl": true, "aspects": ["return"],
   "computes": "최근 {n}거래일 종가 수익률(%)", "label": "최근 {n}일 {value:+.1f}%",
   "ground": {"param": "n", "as": ["{v}거래일", "{v}일"]}},

  "above_ma": {"data": "eod_close_ma", "impl": true, "aspects": ["ma"],
   "computes": "종가가 {ma}일선 위인가", "label": "{symbol} 종가 {ma}일선 대비 {value:+.1f}%",
   "ground": {"param": "ma", "as": ["{v}일", "{v}거래일"]}},
  "hold_above_ma": {"data": "eod_close_ma", "impl": true, "aspects": ["ma", "streak_days"],
   "computes": "{ma}일선 위 연속 거래일수(회복일+{days})", "label": "{symbol} {ma}일선 위 {value}거래일 연속",
   "ground": {"param": "ma", "as": ["{v}일", "{v}거래일"]}},
  "ma_distance": {"data": "eod_close_ma", "impl": true, "aspects": ["ma"],
   "computes": "{ma}일선 대비 이격(%)", "label": "{ma}일선 대비 이격 {value:+.1f}%",
   "ground": {"param": "ma", "as": ["{v}일", "{v}거래일"]}},

  "upper_wick": {"data": "eod_ohlc", "impl": true, "aspects": ["close_pos"],
   "computes": "고가 대비 종가 하락 폭(%) — 윗꼬리 근사", "label": "고점 대비 종가 {value:+.1f}%"},

  "volume_ratio": {"data": "eod_ohlcv", "impl": true, "aspects": ["volume"],
   "computes": "당일 거래량 ÷ 기준거래량(기본 전일)", "label": "거래량 {value:.2f}배 (당일/{baseline})",
   "axes": {"baseline": {"default": "prev", "options": {
     "prev": {"label": "전일", "ground": ["전일", "어제", "직전"]},
     "ma20": {"label": "20일평균", "ground": ["20일", "20거래일", "평균"]}}}},
   "ground": {"by": "baseline"}},

  "count_up_days": {"data": "eod_close", "impl": true, "aspects": ["streak_days"],
   "computes": "최근 {n}거래일 중 상승일 수", "label": "{symbol} {n}일 중 {value}일 상승",
   "ground": {"param": "n", "as": ["{v}거래일", "{v}일"]}},
  "count_up": {"data": "eod_close_multi", "impl": true, "aspects": ["breadth"],
   "computes": "심볼 목록 중 상승 개수", "label": "{value}개 상승"},
  "breadth_count": {"data": "eod_close_multi", "impl": true, "aspects": ["breadth"],
   "computes": "대상 목록 중 조건 충족 개수(폭)", "label": "{value}개 충족"},

  "gap_up": {"data": "eod_open_prev", "impl": true, "aspects": ["gap"],
   "computes": "시초가 vs 전일종가(갭%)", "label": "시가 {value:+.1f}% 갭"},
  "above_open": {"data": "minute_bars", "impl": true, "aspects": ["gap"],
   "computes": "장중 시초가 위 유지 여부", "label": "시초가 {value}"},
  "higher_low": {"data": "minute_bars", "impl": true, "aspects": ["low_break"],
   "computes": "첫 눌림에서 저점을 높였는지(장중)", "label": "저점 {value}"},

  "prev_low_break": {"data": "eod_ohlc_multi", "impl": true, "aspects": ["low_break"],
   "computes": "전일 저점 이탈 개수", "label": "{value}개 전일 저점 이탈"},
  "breakout_hold": {"data": "eod_ohlc", "impl": true, "aspects": ["breakout"],
   "computes": "전고점 위 연속 유지 거래일수", "label": "전고점 위 {value}거래일 유지"},

  "pullback_length": {"data": "eod_close", "impl": true, "aspects": ["pullback"],
   "computes": "고점 이후 눌림 거래일수 — 반등 미확인", "label": "최근 고점 이후 {value}거래일 눌림",
   "supersede": {"type": "pullback_resume", "param_map": {"max": "max_days"}, "drop": ["op", "threshold"]}},
  "pullback_resume": {"data": "eod_ohlc", "impl": true, "aspects": ["pullback", "resume"],
   "computes": "짧은 눌림(≤{max_days}거래일) 끝 반등 + (선택)전일저점 유지", "label": "{symbol} 눌림 {value}일 · 반등 확인"},

  "declining_days": {"data": "eod_close", "impl": true, "aspects": ["streak_days"],
   "computes": "종가 연속 하락 일수", "label": "{symbol} {value}일 연속 하락"},

  "minute_high_hold": {"data": "minute_bars", "impl": false},
  "updown_magnitude": {"data": "eod_close", "impl": false},
  "rise_from_low": {"data": "eod_close", "impl": false}
 },
 "no_data_types": {
  "_note": "jhts 시세수집팀·무료 소스에 데이터 자체가 없는 것들. 여기 속해야만 정당한 ✋직접이다.",
  "news_sentiment": "뉴스 헤드라인 온도·재료 소진 (정성 — 구조화 소스 없음)",
  "analyst_estimate": "애널리스트 실적 추정치 상향/하향 (무료 소스 없음)",
  "kr_flow": "한국 창구별 수급 (무료 실시간 소스 없음)",
  "event_timestamp": "뉴스 발표 '시각' 기준 창(무료 뉴스 이벤트 피드 없음). 개장 기준 창은 minute_* 로 자동 가능.",
  "manual_confirm": {"note": "무료 EOD로 자동 판정 불가 — 사람이 차트/거래량을 직접 확인"}
 }
}
