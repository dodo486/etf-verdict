{
 "version": 3,
 "products": {
  "TQQQ": {"index": "^NDX", "ref": "1-1"},
  "SOXL": {"index": "^SOX", "ref": "1-1"},
  "UPRO": {"index": "^GSPC", "ref": "1-1"}
 },
 "names": {
  "$빅테크": {
   "syms": ["NVDA", "MSFT", "AAPL", "AMZN", "META", "GOOGL", "TSLA"],
   "ref": "2-1",
   "note": "엔비디아·MS·애플·아마존·메타·구글·테슬라"
  },
  "$반도체대표주": {"syms": ["NVDA", "AMD", "AVGO"], "ref": "4-2", "note": "운영 판단: SOXL 핵심 대표 3종(엔비디아·AMD·브로드컴)"}
 },
 "rules": [
  {
   "label": "VIX 전일 대비",
   "ref": "2-4·2-6·1-5·6-3·9-4·9-5·3-5·5-5",
   "note": "'VIX가 튄다'=전일 종가 대비 변화율. +10% 안 산다·+20% 판다. 삼켜지는 회피 접음(§4-3): 2-4 '+20%+갭상승'·2-5 세방향·1-5 바닥권+20%는 VIX≥10 을 품어 행동 바꾸는 날 없음. +20% 판다는 do 달라 남김. 축소 비율 미명시.",
   "value": {"pct": [{"px": "close", "sym": "^VIX"}, 1]},
   "then": [
    {"when": {"ge": ["$value", 20]}, "do": "판다", "qty": {"of": "held", "x": "?"}},
    {"when": {"ge": ["$value", 10]}, "do": "안 산다"}
   ]
  },
  {
   "label": "VIX 전일보다 꺾임",
   "ref": "9-5",
   "note": "이름 조건 — 재진입 재료. 전일 대비 변화율 <0.",
   "value": {"lt": [{"pct": [{"px": "close", "sym": "^VIX"}, 1]}, 0]}
  },
  {
   "label": "레버리지 힘받는 장 (20일 추세)",
   "ref": "1-2",
   "note": "이름 조건 — 저자가 측정만 주고 '사라' 안 붙임. 상승일 수는 식, '하락일 낙폭 작다'는 기준 미명시 수동. $index.",
   "value": {
    "all": [
     {
      "ge": [
       {
        "count": [{"gt": [{"px": "close", "sym": "$index"}, {"lag": [{"px": "close", "sym": "$index"}, 1]}]}, 20]
       },
       13
      ]
     },
     {"manual": "하락일 낙폭이 작다 (저자 미명시: '작다'의 기준)"}
    ]
   }
  },
  {
   "label": "돈삭제 가능 구간 (4재료 중 2)",
   "ref": "1-5",
   "note": "4재료 중 2 이상→돈삭제(안 산다). ④ VIX는 '바닥권 대비'라 전일 대비와 다른 측정, pct 1일 직접. $index.",
   "value": {
    "atleast": 2,
    "of": [
     {
      "ge": [
       {
        "count": [{"gt": [{"px": "close", "sym": "$index"}, {"lag": [{"px": "close", "sym": "$index"}, 1]}]}, 10]
       },
       6
      ]
     },
     {"rule": "하락낙폭 > 상승폭"},
     {"rule": "전고점 돌파 후 3일내 되밀림"},
     {"ge": [{"pct": [{"px": "close", "sym": "^VIX"}, 1]}, 20]}
    ]
   },
   "then": [{"when": "$value", "do": "안 산다"}]
  },
  {
   "label": "하락낙폭 > 상승폭",
   "ref": "1-5·2-3·4-3",
   "note": "이름 조건 — 낙폭 합 > 상승폭 합. 창 미명시, 1-5 맥락 10일. $index.",
   "value": {
    "gt": [
     {
      "abs": {
       "sum": [
        {
         "case": [
          [
           {"lt": [{"px": "close", "sym": "$index"}, {"lag": [{"px": "close", "sym": "$index"}, 1]}]},
           {"sub": [{"px": "close", "sym": "$index"}, {"lag": [{"px": "close", "sym": "$index"}, 1]}]}
          ]
         ],
         "else": 0
        },
        10
       ]
      }
     },
     {
      "sum": [
       {
        "case": [
         [
          {"gt": [{"px": "close", "sym": "$index"}, {"lag": [{"px": "close", "sym": "$index"}, 1]}]},
          {"sub": [{"px": "close", "sym": "$index"}, {"lag": [{"px": "close", "sym": "$index"}, 1]}]}
         ]
        ],
        "else": 0
       },
       10
      ]
     }
    ]
   }
  },
  {
   "label": "전고점 돌파 후 3일내 되밀림",
   "ref": "1-5",
   "note": "이름 조건 — 돌파 후 3봉 이내 + 현재가 돌파 당시 종가 아래. 전고점 창 '?'. $index.",
   "value": {
    "all": [
     {
      "le": [
       {
        "barssince": {
         "gt": [
          {"px": "close", "sym": "$index"},
          {"highest": [{"lag": [{"px": "close", "sym": "$index"}, 1]}, "?"]}
         ]
        }
       },
       3
      ]
     },
     {
      "lt": [
       {"px": "close", "sym": "$index"},
       {
        "valuewhen": [
         {
          "gt": [
           {"px": "close", "sym": "$index"},
           {"highest": [{"lag": [{"px": "close", "sym": "$index"}, 1]}, "?"]}
          ]
         },
         {"px": "close", "sym": "$index"}
        ]
       }
      ]
     }
    ]
   }
  },
  {
   "label": "장전 점수 (5지표 중)",
   "ref": "2-6",
   "note": "메인 결정(§4-3 흡수) — 5지표 점수. 4점↑=산다, 2점↓(=3점 미만)=안 산다. '3점 소액만'=관망. 재료는 이름조건 참조.",
   "then": [
    {
     "when": {
      "atleast": 4,
      "of": [
       {"rule": "나스닥선물 고점 안낮춤"},
       {"rule": "S&P선물 전일종가 위 버팀"},
       {"rule": "VIX 안정"},
       {"rule": "10년물 금리 안정"},
       {"rule": "달러 약세/중립"}
      ]
     },
     "do": "산다"
    },
    {
     "when": {
      "not": {
       "atleast": 3,
       "of": [
        {"rule": "나스닥선물 고점 안낮춤"},
        {"rule": "S&P선물 전일종가 위 버팀"},
        {"rule": "VIX 안정"},
        {"rule": "10년물 금리 안정"},
        {"rule": "달러 약세/중립"}
       ]
      }
     },
     "do": "안 산다"
    }
   ]
  },
  {
   "label": "나스닥선물 고점 안낮춤",
   "ref": "2-6·2-5",
   "note": "이름 조건 — 장전 재료. 당일 고점 ≥ 전일 고점. NQ=F.",
   "value": {"ge": [{"px": "high", "sym": "NQ=F"}, {"lag": [{"px": "high", "sym": "NQ=F"}, 1]}]}
  },
  {
   "label": "S&P선물 전일종가 위 버팀",
   "ref": "2-6",
   "note": "이름 조건 — 장전 재료. ES=F 전일 종가 위.",
   "value": {"gt": [{"px": "close", "sym": "ES=F"}, {"lag": [{"px": "close", "sym": "ES=F"}, 1]}]}
  },
  {
   "label": "VIX 안정",
   "ref": "2-6·2-4",
   "note": "이름 조건 — 장전 재료(VIX 1점). 전일 대비 +10% 미만.",
   "value": {"lt": [{"pct": [{"px": "close", "sym": "^VIX"}, 1]}, 10]}
  },
  {
   "label": "10년물 금리 안정",
   "ref": "2-6·2-5",
   "note": "이름 조건 — 장전 재료. 하루 변화폭 안정(기준 '?') AND 이틀 연속 상승 아님. ^TNX 값=%.",
   "value": {
    "all": [
     {"lt": [{"abs": {"pct": [{"px": "close", "sym": "^TNX"}, 1]}}, "?"]},
     {
      "not": {
       "ge": [
        {"streak": {"gt": [{"px": "close", "sym": "^TNX"}, {"lag": [{"px": "close", "sym": "^TNX"}, 1]}]}},
        2
       ]
      }
     }
    ]
   }
  },
  {
   "label": "달러 약세/중립",
   "ref": "2-6·2-5",
   "note": "이름 조건 — 장전 재료. 달러인덱스 전일 대비 ≤0. DX-Y.NYB.",
   "value": {"le": [{"pct": [{"px": "close", "sym": "DX-Y.NYB"}, 1]}, 0]}
  },
  {
   "label": "금리 급등 (0.1%p)",
   "ref": "2-5",
   "note": "이름 조건 — 저자가 측정만(경고). ^TNX 값=% 이므로 전일 대비 절대 변화(%p) ≥0.1.",
   "value": {
    "ge": [
     {"abs": {"sub": [{"px": "close", "sym": "^TNX"}, {"lag": [{"px": "close", "sym": "^TNX"}, 1]}]}},
     0.1
    ]
   }
  },
  {
   "label": "나스닥 살아나는 날 (30분 3줄)",
   "ref": "2-1·7-1·7-2",
   "on": ["TQQQ"],
   "note": "30분 뒤 3줄 중 2↑이면 산다. 시초가 위(장중>시가), 빅테크 3개 플러스(across), 첫 눌림 저점은 연산없음 수동. 7-1·7-2도 같은 내용.",
   "then": [
    {
     "when": {
      "atleast": 2,
      "of": [
       {"gt": [{"px": "close", "sym": "$index", "tf": "1m"}, {"px": "open", "sym": "$index", "tf": "1d"}]},
       {"manual": "첫 눌림 저점을 지켰는가 (장중 첫 눌림 저점 — 연산 없음)"},
       {
        "ge": [
         {
          "across": {
           "syms": ["NVDA", "MSFT", "AAPL", "AMZN", "META", "GOOGL", "TSLA"],
           "cond": {"gt": [{"px": "close", "sym": "$s", "tf": "1m"}, {"lag": [{"px": "close", "sym": "$s"}, 1]}]}
          }
         },
         3
        ]
       }
      ]
     },
     "do": "산다"
    },
    {
     "when": {
      "not": {
       "atleast": 2,
       "of": [
        {"gt": [{"px": "close", "sym": "$index", "tf": "1m"}, {"px": "open", "sym": "$index", "tf": "1d"}]},
        {"manual": "첫 눌림 저점을 지켰는가 (장중 첫 눌림 저점 — 연산 없음)"},
        {
         "ge": [
          {
           "across": {
            "syms": ["NVDA", "MSFT", "AAPL", "AMZN", "META", "GOOGL", "TSLA"],
            "cond": {"gt": [{"px": "close", "sym": "$s", "tf": "1m"}, {"lag": [{"px": "close", "sym": "$s"}, 1]}]}
           }
          },
          3
         ]
        }
       ]
      }
     },
     "do": "안 산다"
    }
   ]
  },
  {
   "label": "S&P500 위치 (UPRO 진입)",
   "ref": "2-2",
   "on": ["UPRO"],
   "note": "전고점 돌파 후 2~3일 버티면(돌파 후 ≥2봉 + 돌파 후 최저가>돌파종가) 산다. 20일선 아래=안 산다('쉬거나 작게'→크기말 보수, 원칙2). 전고점 창 '?'.",
   "then": [
    {
     "when": {
      "all": [
       {
        "gt": [{"px": "close", "sym": "$index"}, {"div": [{"sum": [{"px": "close", "sym": "$index"}, 20]}, 20]}]
       },
       {
        "ge": [
         {
          "barssince": {
           "gt": [
            {"px": "close", "sym": "$index"},
            {"highest": [{"lag": [{"px": "close", "sym": "$index"}, 1]}, "?"]}
           ]
          }
         },
         2
        ]
       },
       {
        "gt": [
         {
          "minsince": [
           {
            "gt": [
             {"px": "close", "sym": "$index"},
             {"highest": [{"lag": [{"px": "close", "sym": "$index"}, 1]}, "?"]}
            ]
           },
           {"px": "close", "sym": "$index"}
          ]
         },
         {
          "valuewhen": [
           {
            "gt": [
             {"px": "close", "sym": "$index"},
             {"highest": [{"lag": [{"px": "close", "sym": "$index"}, 1]}, "?"]}
            ]
           },
           {"px": "close", "sym": "$index"}
          ]
         }
        ]
       }
      ]
     },
     "do": "산다"
    },
    {
     "when": {
      "lt": [{"px": "close", "sym": "$index"}, {"div": [{"sum": [{"px": "close", "sym": "$index"}, 20]}, 20]}]
     },
     "do": "안 산다"
    }
   ]
  },
  {
   "label": "SOXL 과열 (4재료 중 2)",
   "ref": "2-3",
   "on": ["SOXL"],
   "note": "4재료 중 2↑→안 산다. ① ^SOX 10일중 상승 7일 + SOXL 5일 20% ② 5일선 이격 수동 ③ 분산(참조) ④ 뉴스 온도 수동.",
   "value": {
    "atleast": 2,
    "of": [
     {
      "all": [
       {
        "ge": [
         {
          "count": [{"gt": [{"px": "close", "sym": "$index"}, {"lag": [{"px": "close", "sym": "$index"}, 1]}]}, 10]
         },
         7
        ]
       },
       {"ge": [{"pct": [{"px": "close"}, 5]}, 20]}
      ]
     },
     {"manual": "5일선과 가격이 너무 벌어짐 (폭 저자 미명시)"},
     {"rule": "반도체 주도주 분산 (6중 4)"},
     {"manual": "좋은 뉴스가 가격보다 먼저 (뉴스 온도 — 연산 없음)"}
    ]
   },
   "then": [{"when": "$value", "do": "안 산다"}]
  },
  {
   "label": "반도체 주도주 분산 (6중 4)",
   "ref": "2-3",
   "on": ["SOXL"],
   "note": "이름 조건 — 좁은 장(분산)=6종 중 상승 4개 미만. 장비주=LRCX.",
   "value": {
    "not": {
     "ge": [
      {
       "across": {
        "syms": ["^SOX", "NVDA", "AMD", "AVGO", "MU", "LRCX"],
        "cond": {"gt": [{"px": "close", "sym": "$s"}, {"lag": [{"px": "close", "sym": "$s"}, 1]}]}
       }
      },
      4
     ]
    }
   }
  },
  {
   "label": "뉴스 전 가격 위치 (3재료 중 2 불편)",
   "ref": "2-7",
   "note": "3재료 중 2 불편→조심(안 산다). 이격폭·뉴스시점 수동.",
   "then": [
    {
     "when": {
      "atleast": 2,
      "of": [
       {"rule": "최근 5일 과다상승"},
       {"manual": "가격이 5일선과 너무 벌어짐 (이격 폭 저자 미명시)"},
       {"manual": "뉴스 후 첫 30분 고점 못 지킴 (장중 뉴스 시점 — 연산 없음)"}
      ]
     },
     "do": "안 산다"
    }
   ]
  },
  {
   "label": "최근 5일 과다상승",
   "ref": "2-7·3-1·3-5",
   "note": "이름 조건 — 최근 5거래일 상승률. 기준 '?'. 여러 규칙 공유. SOXL 15%(4-5)는 별 규칙.",
   "value": {"ge": [{"pct": [{"px": "close"}, 5]}, "?"]}
  },
  {
   "label": "TQQQ 매수 3자리",
   "ref": "3-1",
   "on": ["TQQQ"],
   "note": "20일선 위 AND 피해자리(3문장 중 2불편) 아니면 산다. 3-1 '매수 전 3문장'이 체크리스트라 그것으로. $index.",
   "then": [
    {
     "when": {
      "all": [
       {
        "gt": [{"px": "close", "sym": "$index"}, {"div": [{"sum": [{"px": "close", "sym": "$index"}, 20]}, 20]}]
       },
       {"not": {"rule": "TQQQ 피해야 할 3자리 (3중 2)"}}
      ]
     },
     "do": "산다"
    },
    {"when": {"rule": "TQQQ 피해야 할 3자리 (3중 2)"}, "do": "안 산다"}
   ]
  },
  {
   "label": "TQQQ 피해야 할 3자리 (3중 2)",
   "ref": "3-1",
   "on": ["TQQQ"],
   "note": "이름 조건 — 3문장 불편 중 2↑. ① 20일선 아래 ② 5일 과다상승 ③ 윗꼬리 반복 수동.",
   "value": {
    "atleast": 2,
    "of": [
     {
      "lt": [{"px": "close", "sym": "$index"}, {"div": [{"sum": [{"px": "close", "sym": "$index"}, 20]}, 20]}]
     },
     {"rule": "최근 5일 과다상승"},
     {"manual": "전고점 근처 윗꼬리 반복 (저자 미명시: 반복 횟수)"}
    ]
   }
  },
  {
   "label": "나스닥100 상승초입 필터 (20·60일선)",
   "ref": "3-2",
   "on": ["TQQQ"],
   "note": "이름 조건 — '필터'(환경). 20일선 위 2일연속 + 60일선 위 + 두 선 기울기 상승. $index.",
   "value": {
    "all": [
     {
      "gt": [{"px": "close", "sym": "$index"}, {"div": [{"sum": [{"px": "close", "sym": "$index"}, 20]}, 20]}]
     },
     {
      "ge": [
       {
        "streak": {
         "gt": [{"px": "close", "sym": "$index"}, {"div": [{"sum": [{"px": "close", "sym": "$index"}, 20]}, 20]}]
        }
       },
       2
      ]
     },
     {
      "gt": [{"px": "close", "sym": "$index"}, {"div": [{"sum": [{"px": "close", "sym": "$index"}, 60]}, 60]}]
     },
     {
      "gt": [
       {"div": [{"sum": [{"px": "close", "sym": "$index"}, 20]}, 20]},
       {"lag": [{"div": [{"sum": [{"px": "close", "sym": "$index"}, 20]}, 20]}, 1]}
      ]
     },
     {
      "gt": [
       {"div": [{"sum": [{"px": "close", "sym": "$index"}, 60]}, 60]},
       {"lag": [{"div": [{"sum": [{"px": "close", "sym": "$index"}, 60]}, 60]}, 1]}
      ]
     }
    ]
   }
  },
  {
   "label": "TQQQ 전고점 분할매수",
   "ref": "3-3·3-4",
   "on": ["TQQQ"],
   "note": "3차 분할. 3-3 배분(25·25·50) 채택(3-4 25·30·45 note). 1차 돌파 전, 2차 돌파+1차 후, 3차 돌파 후 2일버팀+2차 후. 전고점 창 '?'.",
   "then": [
    {
     "when": {"lt": [{"px": "close"}, {"highest": [{"lag": [{"px": "close"}, 1]}, "?"]}]},
     "do": "산다",
     "qty": {"of": "budget", "x": 0.25}
    },
    {
     "when": {
      "all": [
       {"gt": [{"px": "close"}, {"highest": [{"lag": [{"px": "close"}, 1]}, "?"]}]},
       {"ge": [{"pos": "filled", "rule": "TQQQ 전고점 분할매수"}, 1]}
      ]
     },
     "do": "산다",
     "qty": {"of": "budget", "x": 0.25}
    },
    {
     "when": {
      "all": [
       {
        "ge": [{"barssince": {"gt": [{"px": "close"}, {"highest": [{"lag": [{"px": "close"}, 1]}, "?"]}]}}, 2]
