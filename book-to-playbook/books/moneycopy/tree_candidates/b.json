{
 "version": 3,
 "products": {
  "TQQQ": {"index": "^NDX", "ref": "3-2"},
  "SOXL": {"index": "^SOX", "ref": "2-3"},
  "UPRO": {"index": "^GSPC", "ref": "2-2"}
 },
 "rules": [
  {
   "label": "지수 20일선 위",
   "ref": "2-2·3-2·5-1",
   "value": {
    "gt": [{"px": "close", "sym": "$index"}, {"div": [{"sum": [{"px": "close", "sym": "$index"}, 20]}, 20]}]
   },
   "note": "상품의 기준 지수(TQQQ=나스닥100, UPRO=S&P500, SOXL=반도체 지수) 종가가 20일 평균 위"
  },
  {
   "label": "지수 20일선 위 2거래일 유지",
   "ref": "3-2·5-2",
   "value": {"ge": [{"barssince": {"not": {"rule": "지수 20일선 위"}}}, 2]},
   "note": "연속 참 일수 패턴(barssince(not 조건) ≥ 2)"
  },
  {
   "label": "지수 60일선 위",
   "ref": "3-2·5-2",
   "value": {
    "gt": [{"px": "close", "sym": "$index"}, {"div": [{"sum": [{"px": "close", "sym": "$index"}, 60]}, 60]}]
   }
  },
  {
   "label": "지수 20일선 하락",
   "ref": "3-2",
   "value": {
    "lt": [
     {"div": [{"sum": [{"px": "close", "sym": "$index"}, 20]}, 20]},
     {"lag": [{"div": [{"sum": [{"px": "close", "sym": "$index"}, 20]}, 20]}, 1]}
    ]
   },
   "note": "기울기 = 20일 평균이 전일 20일 평균보다 낮음"
  },
  {
   "label": "지수 60일선 하락",
   "ref": "3-2",
   "value": {
    "lt": [
     {"div": [{"sum": [{"px": "close", "sym": "$index"}, 60]}, 60]},
     {"lag": [{"div": [{"sum": [{"px": "close", "sym": "$index"}, 60]}, 60]}, 1]}
    ]
   }
  },
  {
   "label": "지수 20일선 아래 2거래일 연속",
   "ref": "7-6·6-5",
   "value": {"ge": [{"barssince": {"rule": "지수 20일선 위"}}, 2]}
  },
  {
   "label": "상품 20일선 위",
   "ref": "3-1",
   "value": {
    "gt": [{"px": "close", "sym": "$self"}, {"div": [{"sum": [{"px": "close", "sym": "$self"}, 20]}, 20]}]
   },
   "note": "3-1 은 TQQQ 자기 차트의 위치(양봉·윗꼬리와 같은 문단)로 읽어 $self"
  },
  {
   "label": "상품 5일 상승률",
   "ref": "2-7·3-1·4-5",
   "value": {
    "mul": [
     {
      "sub": [{"div": [{"px": "close", "sym": "$self"}, {"lag": [{"px": "close", "sym": "$self"}, 5]}]}, 1]
     },
     100
    ]
   }
  },
  {
   "label": "5일 상승 과다",
   "ref": "2-7·3-1",
   "value": {"ge": [{"rule": "상품 5일 상승률"}, "?"], "label": "5일 상승률 과다(기준 미명시)", "ref": "3-1"}
  },
  {
   "label": "5일선 이격 과다",
   "ref": "2-7",
   "value": {
    "ge": [
     {
      "mul": [
       {
        "sub": [
         {
          "div": [{"px": "close", "sym": "$self"}, {"div": [{"sum": [{"px": "close", "sym": "$self"}, 5]}, 5]}]
         },
         1
        ]
       },
       100
      ]
     },
     "?"
    ],
    "label": "5일선 대비 이격 과다(폭 미명시)",
    "ref": "2-7"
   }
  },
  {
   "label": "윗꼬리 긺",
   "ref": "4-3·4-5·7-1",
   "value": {
    "ge": [
     {
      "sub": [
       {"px": "high", "sym": "$self"},
       {"max": [{"px": "open", "sym": "$self"}, {"px": "close", "sym": "$self"}]}
      ]
     },
     "?"
    ],
    "label": "윗꼬리 길이 과다(기준 미명시)",
    "ref": "4-3"
   }
  },
  {
   "label": "갭상승",
   "ref": "4-5·7-3",
   "value": {"gt": [{"px": "open", "sym": "$self"}, {"lag": [{"px": "close", "sym": "$self"}, 1]}]},
   "note": "시가가 전일 종가보다 높게 시작"
  },
  {
   "label": "종가 밀림",
   "ref": "4-3·4-5·7-4",
   "value": {"lt": [{"px": "close", "sym": "$self"}, {"lag": [{"px": "close", "sym": "$self"}, 1]}]},
   "note": "'밀림' = 종가가 전일 종가 아래"
  },
  {
   "label": "거래량 전일 1.5배 이상",
   "ref": "7-4",
   "value": {
    "ge": [{"div": [{"px": "volume", "sym": "$self"}, {"lag": [{"px": "volume", "sym": "$self"}, 1]}]}, 1.5]
   }
  },
  {
   "label": "거래량 터짐 종가 밀림",
   "ref": "7-4·4-5",
   "value": {"all": [{"rule": "거래량 전일 1.5배 이상"}, {"rule": "종가 밀림"}]},
   "note": "'터짐' = 7-4 의 전일 1.5배. 위치(아래/위) 구분은 저자가 기준을 안 줘 식에 넣지 않음"
  },
  {
   "label": "종가 고점 근처 마감",
   "ref": "7-4",
   "value": {
    "ge": [{"div": [{"px": "close", "sym": "$self"}, {"px": "high", "sym": "$self"}]}, "?"],
    "label": "종가/고가 비율(근처 기준 미명시)",
    "ref": "7-4"
   }
  },
  {
   "label": "하락일 거래량 우위",
   "ref": "7-4",
   "value": {
    "gt": [
     {
      "sum": [
       {
        "case": [
         [
          {"lt": [{"px": "close", "sym": "$self"}, {"lag": [{"px": "close", "sym": "$self"}, 1]}]},
          {"px": "volume", "sym": "$self"}
         ]
        ],
        "else": 0
       },
       "?"
      ]
     },
     {
      "sum": [
       {
        "case": [
         [
          {"gt": [{"px": "close", "sym": "$self"}, {"lag": [{"px": "close", "sym": "$self"}, 1]}]},
          {"px": "volume", "sym": "$self"}
         ]
        ],
        "else": 0
       },
       "?"
      ]
     }
    ],
    "label": "최근 n일 하락일 거래량 합 > 상승일 거래량 합(n 미명시)",
    "ref": "7-4"
   }
  },
  {
   "label": "VIX 튐",
   "ref": "2-4",
   "value": {"ge": [{"rule": "VIX 전일 대비"}, 10]},
   "note": "책에서 'VIX가 튄다' = 전일 대비 10% 이상(2-4)"
  },
  {
   "label": "10년물 금리 하루 0.1%p 이상 상승",
   "ref": "2-5",
   "value": {
    "ge": [{"sub": [{"px": "close", "sym": "^TNX"}, {"lag": [{"px": "close", "sym": "^TNX"}, 1]}]}, 0.1]
   },
   "note": "^TNX 값 = %, 0.1 = 0.1%p"
  },
  {
   "label": "10년물 금리 불편",
   "ref": "2-6",
   "value": {
    "any": [
     {"rule": "10년물 금리 하루 0.1%p 이상 상승"},
     {
      "ge": [
       {
        "barssince": {"not": {"gt": [{"px": "close", "sym": "^TNX"}, {"lag": [{"px": "close", "sym": "^TNX"}, 1]}]}}
       },
       2
      ],
      "label": "10년물 금리 이틀 연속 상승",
      "ref": "2-6"
     }
    ]
   },
   "note": "'하루 변화폭'의 기준은 2-5 의 0.1%p"
  },
  {
   "label": "달러인덱스 강세",
   "ref": "2-5·2-6",
   "value": {"gt": [{"px": "close", "sym": "DX-Y.NYB"}, {"lag": [{"px": "close", "sym": "DX-Y.NYB"}, 1]}]},
   "note": "달러인덱스 = DX-Y.NYB, 강세 = 전일 대비 상승"
  },
  {
   "label": "나스닥 선물 고점 유지",
   "ref": "2-6",
   "value": {"ge": [{"px": "high", "sym": "NQ=F"}, {"lag": [{"px": "high", "sym": "NQ=F"}, 1]}]},
   "note": "고점을 낮추지 않음 = 오늘 고가 ≥ 전일 고가"
  },
  {
   "label": "S&P500 선물 전일 종가 위",
   "ref": "2-6",
   "value": {"gt": [{"px": "close", "sym": "ES=F"}, {"lag": [{"px": "close", "sym": "ES=F"}, 1]}]}
  },
  {
   "label": "장전 5지표 4점 이상",
   "ref": "2-6",
   "value": {
    "atleast": 4,
    "of": [
     {"rule": "나스닥 선물 고점 유지"},
     {"rule": "S&P500 선물 전일 종가 위"},
     {"not": {"rule": "VIX 튐"}},
     {"not": {"rule": "10년물 금리 불편"}},
     {"not": {"rule": "달러인덱스 강세"}}
    ]
   },
   "note": "점수 = 5지표 중 유리한 것 개수(VIX 10% 미만·금리 불편 아님·달러 강세 아님)"
  },
  {
   "label": "주도주 동반 상승",
   "ref": "2-1·7-1·7-2",
   "value": {
    "all": [
     {
      "atleast": 3,
      "of": [
       {"gt": [{"px": "close", "sym": "NVDA"}, {"lag": [{"px": "close", "sym": "NVDA"}, 1]}]},
       {"gt": [{"px": "close", "sym": "MSFT"}, {"lag": [{"px": "close", "sym": "MSFT"}, 1]}]},
       {"gt": [{"px": "close", "sym": "AAPL"}, {"lag": [{"px": "close", "sym": "AAPL"}, 1]}]},
       {"gt": [{"px": "close", "sym": "AMZN"}, {"lag": [{"px": "close", "sym": "AMZN"}, 1]}]},
       {"gt": [{"px": "close", "sym": "META"}, {"lag": [{"px": "close", "sym": "META"}, 1]}]},
       {"gt": [{"px": "close", "sym": "GOOGL"}, {"lag": [{"px": "close", "sym": "GOOGL"}, 1]}]},
       {"gt": [{"px": "close", "sym": "TSLA"}, {"lag": [{"px": "close", "sym": "TSLA"}, 1]}]}
      ],
      "label": "빅테크 7개 중 3개 이상 플러스",
      "ref": "2-1",
      "on": ["TQQQ"]
     },
     {
      "atleast": 3,
      "of": [
       {"gt": [{"px": "close", "sym": "NVDA"}, {"lag": [{"px": "close", "sym": "NVDA"}, 1]}]},
       {"gt": [{"px": "close", "sym": "AMD"}, {"lag": [{"px": "close", "sym": "AMD"}, 1]}]},
       {"gt": [{"px": "close", "sym": "AVGO"}, {"lag": [{"px": "close", "sym": "AVGO"}, 1]}]}
      ],
      "label": "엔비디아·AMD·브로드컴 3개 플러스",
      "ref": "7-2",
      "on": ["SOXL"]
     },
     {
      "atleast": 3,
      "of": [
       {"gt": [{"px": "close", "sym": "XLK"}, {"lag": [{"px": "close", "sym": "XLK"}, 1]}]},
       {"gt": [{"px": "close", "sym": "XLF"}, {"lag": [{"px": "close", "sym": "XLF"}, 1]}]},
       {"gt": [{"px": "close", "sym": "XLI"}, {"lag": [{"px": "close", "sym": "XLI"}, 1]}]}
      ],
      "label": "기술·금융·산업재 3개 플러스",
      "ref": "7-2",
      "on": ["UPRO"]
     }
    ]
   },
   "note": "플러스 = 전일 종가 대비 상승. 상품별 주도주 노드(on)로 — 그 밖의 상품에선 투명. UPRO 주도 업종 = 섹터 ETF XLK·XLF·XLI"
  },
  {
   "label": "속임수 반등",
   "ref": "2-1·7-1",
   "value": {
    "all": [
     {"gt": [{"px": "close", "sym": "$index"}, {"lag": [{"px": "close", "sym": "$index"}, 1]}]},
     {"not": {"rule": "주도주 동반 상승"}},
     {"manual": "데이터 없음: 지수 구성 종목의 상승 종목 수(폭)", "label": "상승 종목 폭 좁음", "ref": "2-1"}
    ]
   },
   "note": "측정만 있고 행동 미명시 → 이름 조건"
  },
  {
   "label": "반도체 과열(4중 2)",
   "ref": "2-3",
   "value": {
    "atleast": 2,
    "of": [
     {
      "ge": [
       {
        "sum": [
         {
          "case": [[{"gt": [{"px": "close", "sym": "^SOX"}, {"lag": [{"px": "close", "sym": "^SOX"}, 1]}]}, 1]],
          "else": 0
         },
         10
        ]
       },
       7
      ],
      "label": "반도체 지수 10일 중 상승일 7일 이상",
      "ref": "2-3"
     },
     {
      "ge": [
       {
        "mul": [
         {
          "sub": [
           {
            "div": [{"px": "close", "sym": "SOXL"}, {"div": [{"sum": [{"px": "close", "sym": "SOXL"}, 5]}, 5]}]
           },
           1
          ]
         },
         100
        ]
       },
       "?"
      ],
      "label": "SOXL 5일선 이격 과다(폭 미명시)",
      "ref": "2-3"
     },
     {
      "not": {
       "atleast": 3,
       "of": [
        {"gt": [{"px": "close", "sym": "^SOX"}, {"lag": [{"px": "close", "sym": "^SOX"}, 1]}]},
        {"gt": [{"px": "close", "sym": "NVDA"}, {"lag": [{"px": "close", "sym": "NVDA"}, 1]}]},
        {"gt": [{"px": "close", "sym": "AMD"}, {"lag": [{"px": "close", "sym": "AMD"}, 1]}]},
        {"gt": [{"px": "close", "sym": "AVGO"}, {"lag": [{"px": "close", "sym": "AVGO"}, 1]}]},
        {"gt": [{"px": "close", "sym": "MU"}, {"lag": [{"px": "close", "sym": "MU"}, 1]}]},
        {"gt": [{"px": "close", "sym": "?"}, {"lag": [{"px": "close", "sym": "?"}, 1]}]}
       ]
      },
      "label": "반도체 6개 중 1~2개만 상승",
      "ref": "2-3",
      "note": "장비주는 저자가 종목을 안 줌 → sym '?'. 1~2개만 = 3개 미만"
     },
     {"manual": "데이터 없음: 뉴스가 가격보다 먼저인지 늦게 붙었는지(뉴스 시점)", "label": "반도체 뉴스 온도(늦게 붙은 호재)", "ref": "2-3"}
    ]
   },
   "note": "6-2 '반도체 과열이면 균형형'이 다른 상품에서도 참조하므로 SOXL·^SOX 구체 티커"
  },
  {
   "label": "반도체 대표주 2개 이상 전일 저점 이탈",
   "ref": "4-3·7-6",
   "value": {
    "atleast": 2,
    "of": [
     {"lt": [{"px": "low", "sym": "NVDA"}, {"lag": [{"px": "low", "sym": "NVDA"}, 1]}]},
     {"lt": [{"px": "low", "sym": "AMD"}, {"lag": [{"px": "low", "sym": "AMD"}, 1]}]},
     {"lt": [{"px": "low", "sym": "AVGO"}, {"lag": [{"px": "low", "sym": "AVGO"}, 1]}]}
    ]
   },
   "note": "반도체 대표주 = 엔비디아·AMD·브로드컴(7-2). 저점 이탈 = 오늘 저가 < 전일 저가"
  },
  {
   "label": "상품 급등",
   "ref": "2-3·4-3",
   "value": {
    "ge": [
     {
      "mul": [
       {
        "sub": [{"div": [{"px": "close", "sym": "$self"}, {"lag": [{"px": "close", "sym": "$self"}, 1]}]}, 1]
       },
       100
      ]
     },
     "?"
    ],
    "label": "상품 전일 대비 급등(기준 미명시)",
    "ref": "4-3"
   }
  },
  {
   "label": "상품 전고점",
   "ref": "3-1·3-3",
   "value": {
    "highest": [{"lag": [{"px": "close", "sym": "$self"}, 1]}, "?"],
    "label": "상품 전고점(기간 미명시)",
    "ref": "3-3"
   }
  },
  {
   "label": "상품 전고점 돌파",
   "ref": "3-3",
   "value": {"gt": [{"px": "close", "sym": "$self"}, {"rule": "상품 전고점"}]},
   "note": "종가 기준 돌파"
  },
  {
   "label": "상품 돌파선",
   "ref": "3-3",
   "value": {"valuewhen": [{"rule": "상품 전고점 돌파"}, {"rule": "상품 전고점"}]}
  },
  {
   "label": "상품 전고점 돌파 후 버팀",
   "ref": "3-1·3-3",
   "value": {"gt": [{"minsince": [{"rule": "상품 전고점 돌파"}, {"px": "close", "sym": "$self"}]}, {"rule": "상품 돌파선"}]}
  },
  {
   "label": "상품 실패한 돌파",
   "ref": "3-3",
   "value": {
    "all": [
     {"gt": [{"px": "high", "sym": "$self"}, {"rule": "상품 전고점"}]},
     {"le": [{"px": "close", "sym": "$self"}, {"rule": "상품 전고점"}]}
    ]
   },
   "note": "측정만(행동 미명시) → 이름 조건"
  },
  {
   "label": "전고점 근처 윗꼬리",
   "ref": "3-1·5-5",
   "value": {
    "all": [
     {"rule": "윗꼬리 긺"},
     {
      "ge": [{"div": [{"px": "high", "sym": "$self"}, {"rule": "상품 전고점"}]}, "?"],
      "label": "고가가 전고점 근처(기준 미명시)",
      "ref": "3-1"
     }
    ]
   }
  },
  {
   "label": "전고점 근처 윗꼬리 반복",
   "ref": "3-1",
   "value": {
    "ge": [{"sum": [{"case": [[{"rule": "전고점 근처 윗꼬리"}, 1]], "else": 0}, "?"]}, 2],
    "label": "최근 n일 전고점 윗꼬리 2회 이상(n 미명시)",
    "ref": "3-1"
   },
   "note": "반복 = 2회 이상"
  },
  {
   "label": "지수 전고점",
   "ref": "2-2",
   "value": {
    "highest": [{"lag": [{"px": "close", "sym": "$index"}, 1]}, "?"],
    "label": "지수 전고점(기간 미명시)",
    "ref": "2-2"
   }
  },
  {
   "label": "지수 전고점 돌파",
   "ref": "2-2",
   "value": {"gt": [{"px": "close", "sym": "$index"}, {"rule": "지수 전고점"}]}
  },
  {
   "label": "지수 돌파선",
   "ref": "2-2",
   "value": {"valuewhen": [{"rule": "지수 전고점 돌파"}, {"rule": "지수 전고점"}]}
  },
  {
   "label": "최고 수익 대비 반납률",
   "ref": "4-1·7-5",
   "value": {
    "case": [
     [
      {"gt": [{"pos": "maxret"}, 0]},
      {"mul": [{"div": [{"sub": [{"pos": "maxret"}, {"pos": "ret"}]}, {"pos": "maxret"}]}, 100]}
     ]
    ],
    "else": 0
   },
   "note": "반납률 % = (최고 수익률 − 현재 수익률) ÷ 최고 수익률 × 100, 최고 수익이 없으면 0"
  },
  {
