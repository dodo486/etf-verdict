{
  "version": 1,
  "source": {
    "book": "moneycopy",
    "extractor": "exit_b",
    "sections_read": ["1-3", "1-5", "3-1", "3-2", "3-3", "3-4", "3-5", "4-1", "4-2", "4-3", "4-4", "4-5",
                      "5-1", "5-2", "5-3", "5-4", "5-5", "6-4", "6-5", "7-5", "7-6",
                      "9-1", "9-2", "9-3", "9-4", "9-5", "10-1", "10-2", "10-3", "10-4"]
  },
  "defs": {
    "IDX": {"px": "close", "sym": "$index"},
    "idx_below_ma5_and_ma10": {
      "label": "기준 지수가 5일선·10일선 둘 다 아래",
      "all": [
        {"lt": [{"def": "IDX"}, {"ma": [{"def": "IDX"}, 5]}]},
        {"lt": [{"def": "IDX"}, {"ma": [{"def": "IDX"}, 10]}]}
      ]
    },
    "idx_below_ma20": {
      "label": "기준 지수 종가가 20일선 아래",
      "lt": [{"def": "IDX"}, {"ma": [{"def": "IDX"}, 20]}]
    },
    "semi_leaders_2_break": {
      "label": "엔비디아·AMD·브로드컴 중 2개 이상 전일 저점 이탈(종가 기준)",
      "note": "운영 판단: '전일 저점 이탈' = 오늘 종가 < 전일 저가",
      "ge": [{"across": {"syms": ["NVDA", "AMD", "AVGO"],
                         "cond": {"lt": [{"px": "close", "sym": "$s"}, {"lag": [{"px": "low", "sym": "$s"}, 1]}]}}}, 2]
    },
    "vix_jump_10": {
      "label": "VIX 전일 대비 10% 이상",
      "ge": [{"pct": [{"px": "close", "sym": "^VIX"}, 1]}, 10]
    }
  },
  "exits": {
    "TQQQ": [
      {"label": "1차 익절 30%", "ref": "7-5",
       "note": "원문 '수익률 7~10%' 구간 → 처음 닿는 하한 7. 30%·30%·40% 분할은 처음 물량 기준",
       "when": {"ge": [{"pos": "ret"}, 7]}, "sell": {"initial": 0.3}},
      {"label": "2차 익절 30%", "ref": "7-5",
       "note": "원문 '수익률 15~20%' 구간 → 하한 15",
       "when": {"ge": [{"pos": "ret"}, 15]}, "sell": {"initial": 0.3}},
      {"label": "남은 40% 추세 이탈 정리", "ref": "7-5",
       "note": "'나스닥이 5일선이나 10일선을 지키는지' → 둘 다 깨지면 추세 소멸로 봄. 2차 익절(최고 수익 15% 이상) 이후에만",
       "when": {"all": [{"ge": [{"pos": "maxret"}, 15]}, {"def": "idx_below_ma5_and_ma10"}]}, "sell": "all"},
      {"label": "가격 손절 -5% 30% 축소", "ref": "7-6",
       "note": "'-5%에서 30% 축소' — 남은 물량 기준으로 해석",
       "when": {"le": [{"pos": "ret"}, -5]}, "sell": {"remaining": 0.3}},
      {"label": "구조 이탈(나스닥 20일선 이탈) 50% 축소", "ref": "7-6",
       "note": "구조 기준 '나스닥 20일선 이탈' + '구조 이탈 시 50% 축소'",
       "when": {"def": "idx_below_ma20"}, "sell": {"remaining": 0.5}},
      {"label": "수익 10%+ 과열 신호 시 30% 낮춤", "ref": "5-5",
       "note": "TQQQ 보유분 수익 10% 이상 + (VIX 전일 대비 10% 이상 또는 나스닥 전고점 근처 윗꼬리) → 30%를 UPRO로 낮춤(TQQQ 쪽에서는 매도)",
       "when": {"all": [
         {"ge": [{"pos": "ret"}, 10]},
         {"any": [{"def": "vix_jump_10"},
                  {"manual": "저자 미명시: 나스닥100 전고점 근처 윗꼬리(근처·꼬리 길이 기준 없음)"}]}
       ]}, "sell": {"remaining": 0.3}},
      {"label": "수익 15%+ 주도주 약화 시 50% 낮춤", "ref": "5-5",
       "note": "'50%까지 낮출 수 있습니다' → 50%로 씀. 빅테크 주도주 '약해짐' 기준 없음",
       "when": {"all": [
         {"ge": [{"pos": "ret"}, 15]},
         {"manual": "저자 미명시: 빅테크 주도주 2개 이상 약해짐(종목·약세 기준 없음)"}
       ]}, "sell": {"remaining": 0.5}}
    ],
    "SOXL": [
      {"label": "1차 익절 30%", "ref": "7-5",
       "note": "SOXL은 '10~12%'(7-5), '10% 부근'(4-3) → 하한 10",
       "when": {"ge": [{"pos": "ret"}, 10]}, "sell": {"initial": 0.3}},
      {"label": "2차 익절 30%", "ref": "4-3",
       "note": "'15~20% 구간에서 30%'(4-3, 7-5) → 하한 15",
       "when": {"ge": [{"pos": "ret"}, 15]}, "sell": {"initial": 0.3}},
      {"label": "남은 40% 대표주 약화 정리", "ref": "7-5",
       "note": "'반도체 대표주 3개 중 2개 이상이 살아 있는지' → 2개 이상 전일 저점 이탈이면 소멸로 봄(7-6 구조 기준 정의 차용, 운영 판단). 2차 익절 이후에만",
       "when": {"all": [{"ge": [{"pos": "maxret"}, 15]}, {"def": "semi_leaders_2_break"}]}, "sell": "all"},
      {"label": "가격 손절 -5% 30% 축소", "ref": "7-6",
       "when": {"le": [{"pos": "ret"}, -5]}, "sell": {"remaining": 0.3}},
      {"label": "SOXL -7% 절반 축소", "ref": "6-4",
       "note": "'SOXL이 -7%면 절반을 줄입니다'(세 겹 손실선). 사례의 '6%에서 절반'은 쓰지 않음",
       "when": {"le": [{"pos": "ret"}, -7]}, "sell": {"remaining": 0.5}},
      {"label": "구조 이탈(대표주 2개 전일 저점 이탈) 50% 축소", "ref": "7-6",
       "note": "구조 기준 '반도체 대표주 2개 이상 전일 저점 이탈' + '구조 이탈 시 50% 축소'",
       "when": {"def": "semi_leaders_2_break"}, "sell": {"remaining": 0.5}},
      {"label": "수익 중 윗꼬리 30% 덜기", "ref": "4-3",
       "note": "'수익 중일 때 윗꼬리가 나오면 최소 30%는 덜어낼 만합니다'",
       "when": {"all": [
         {"gt": [{"pos": "ret"}, 0]},
         {"manual": "저자 미명시: 반도체 지수·SOXL 윗꼬리(꼬리 길이 기준 없음)"}
       ]}, "sell": {"remaining": 0.3}},
      {"label": "수익 10%+ 과열 신호 시 30% 낮춤", "ref": "5-5",
       "when": {"all": [
         {"ge": [{"pos": "ret"}, 10]},
         {"any": [{"def": "vix_jump_10"},
                  {"manual": "저자 미명시: 반도체 지수 전고점 근처 윗꼬리(근처·꼬리 길이 기준 없음)"}]}
       ]}, "sell": {"remaining": 0.3}},
      {"label": "수익 15%+ 주도주 2개 약화 시 50% 낮춤", "ref": "5-5",
       "note": "'50%까지 낮출 수 있습니다' → 50%. 주도주 약화 = 4-3 '2개 이상 전일 저점 이탈'로 계산(운영 판단)",
       "when": {"all": [{"ge": [{"pos": "ret"}, 15]}, {"def": "semi_leaders_2_break"}]}, "sell": {"remaining": 0.5}}
    ],
    "UPRO": [
      {"label": "1차 익절 30%", "ref": "7-5",
       "note": "TQQQ·UPRO '7~10%' → 하한 7",
       "when": {"ge": [{"pos": "ret"}, 7]}, "sell": {"initial": 0.3}},
      {"label": "2차 익절 30%", "ref": "7-5",
       "when": {"ge": [{"pos": "ret"}, 15]}, "sell": {"initial": 0.3}},
      {"label": "남은 40% S&P500 20일선 이탈 정리", "ref": "7-5",
       "note": "'S&P500이 20일선 위에서 버티고 업종 상승 폭이 유지되는지' 중 20일선만 계산(업종 폭은 기준 없음). 2차 익절 이후에만",
       "when": {"all": [{"ge": [{"pos": "maxret"}, 15]}, {"def": "idx_below_ma20"}]}, "sell": "all"},
      {"label": "가격 손절 -5% 30% 축소", "ref": "7-6",
       "when": {"le": [{"pos": "ret"}, -5]}, "sell": {"remaining": 0.3}},
      {"label": "구조 이탈(S&P500 20일선 2거래일 연속 이탈) 50% 축소", "ref": "7-6",
       "note": "구조 기준 'S&P500 20일선 2거래일 연속 이탈' + '구조 이탈 시 50% 축소'",
       "when": {"ge": [{"streak": {"def": "idx_below_ma20"}}, 2]}, "sell": {"remaining": 0.5}},
      {"label": "경기민감 업종 약세 30% 덜기", "ref": "5-3",
       "note": "'금융과 산업재가 5거래일 이상 약하고, 헬스케어와 유틸리티만 버티면 … 30%라도 먼저 덜어내야'",
       "when": {"manual": "저자 미명시: 금융·산업재 5거래일 이상 '약함' / 헬스케어·유틸리티 '버팀'의 수치 기준 없음"},
       "sell": {"remaining": 0.3}}
    ]
  }
}
