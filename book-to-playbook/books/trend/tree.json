{
 "version": 1,
 "source": {
  "book": "trend",
  "extractor": "채택",
  "base": "a",
  "review": {
   "QQQ.entry": "custom"
  }
 },
 "defs": {
  "env_stable": {
   "all": [
    {
     "label": "개장 전 S&P500·나스닥 선물 방향 안정(둘 다 마이너스가 아님)",
     "ref": "1-1",
     "manual": "개장 전 선물 방향(ES=F·NQ=F 전일 종가 대비) — 개장 전 시점이라 일봉으로 판정 불가. 둘 다 마이너스면 관망, 둘 다 플러스면 우호적"
    },
    {
     "label": "변동성 안정: VIX 전일 대비 10% 이상 급등 아님",
     "ref": "1-2",
     "not": {
      "ge": [
       {
        "pct": [
         {
          "px": "close",
          "sym": "^VIX"
         },
         1
        ]
       },
       10
      ]
     }
    },
    {
     "label": "금리 안정: 10년물 하루 0.1%p 초과 상승도, 이틀 연속 상승도 아님",
     "ref": "1-3",
     "not": {
      "any": [
       {
        "label": "10년물 금리 전일 대비 0.1%p 초과 상승",
        "ref": "1-3",
        "gt": [
         {
          "sub": [
           {
            "px": "close",
            "sym": "^TNX"
           },
           {
            "lag": [
             {
              "px": "close",
              "sym": "^TNX"
             },
             1
            ]
           }
          ]
         },
         0.1
        ]
       },
       {
        "label": "10년물 금리 2거래일 연속 상승",
        "ref": "1-3",
        "ge": [
         {
          "streak": {
           "gt": [
            {
             "px": "close",
             "sym": "^TNX"
            },
            {
             "lag": [
              {
               "px": "close",
               "sym": "^TNX"
              },
              1
             ]
            }
           ]
          }
         },
         2
        ]
       }
      ]
     }
    }
   ],
   "label": "아침 환경 점검 3가지 모두 안정(하나라도 흔들리면 관망)",
   "ref": "1-5"
  },
  "idx_above_ma20": {
   "label": "기준 지수 종가 > 20일선",
   "ref": "프롤로그",
   "gt": [
    {
     "px": "close",
     "sym": "$index"
    },
    {
     "ma": [
      {
       "px": "close",
       "sym": "$index"
      },
      20
     ]
    }
   ]
  },
  "idx_hold_ma20_2d": {
   "label": "지수 20일선 종가 회복 후 2거래일 유지(3일 연속 종가 > 20일선)",
   "ref": "프롤로그",
   "ge": [
    {
     "streak": {
      "gt": [
       {
        "px": "close",
        "sym": "$index"
       },
       {
        "ma": [
         {
          "px": "close",
          "sym": "$index"
         },
         20
        ]
       }
      ]
     }
    },
    3
   ]
  },
  "avoid_common": {
   "any": [
    {
     "label": "최근 5거래일 20% 넘게 상승(추격 금지)",
     "ref": "3-1",
     "gt": [
      {
       "pct": [
        {
         "px": "close"
        },
        5
       ]
      },
      20
     ]
    },
    {
     "label": "종가가 5일선에서 크게 벌어짐(단기 과열)",
     "ref": "3-1",
     "manual": "저자 미명시: 5일선 이격 '크게' — 숫자 없음"
    },
    {
     "label": "고점 대비 종가 4% 이상 밀린 윗꼬리 마감",
     "ref": "3-2",
     "ge": [
      {
       "mul": [
        {
         "div": [
          {
           "sub": [
            {
             "px": "high"
            },
            {
             "px": "close"
            }
           ]
          },
          {
           "px": "high"
          }
         ]
        },
        100
       ]
      },
      4
     ]
    },
    {
     "label": "거래량 전일 1.5배 이상 + 종가가 고점 아래로 밀림",
     "ref": "3-2",
     "all": [
      {
       "label": "거래량 전일 대비 1.5배 이상",
       "ref": "3-2",
       "ge": [
        {
         "div": [
          {
           "px": "volume"
          },
          {
           "lag": [
            {
             "px": "volume"
            },
            1
           ]
          }
         ]
        },
        1.5
       ]
      },
      {
       "label": "종가가 고점 아래로 밀림",
       "ref": "3-2",
       "manual": "저자 미명시: 고점 대비 얼마나 밀려야 하는지 숫자 없음"
      }
     ]
    }
   ],
   "label": "과열·매도 신호 자리(새로 사지 않음)",
   "ref": "3-1"
  }
 },
 "products": {
  "SPY": {
   "index": "^GSPC",
   "note": "2-1. 전고점 돌파 후 2거래일 버팀은 '비중 키우기'라 제외",
   "filter": {
    "all": [
     {
      "def": "idx_above_ma20"
     },
     {
      "def": "env_stable"
     }
    ]
   },
   "entry": {
    "all": [
     {
      "def": "idx_hold_ma20_2d",
      "ref": "2-1"
     }
    ]
   },
   "avoid": {
    "def": "avoid_common"
   }
  },
  "QQQ": {
   "index": "^NDX",
   "note": "2-2",
   "filter": {
    "all": [
     {
      "def": "idx_above_ma20"
     },
     {
      "def": "env_stable"
     }
    ]
   },
   "entry": {
    "label": "나스닥100 20일선 회복 후 2거래일 유지(회복일+2일 = 3일 연속 종가 > 20일선)",
    "ref": "2-2",
    "note": "눌림 끝 자리(2-2 둘째 문장)는 프롤로그의 '2거래일 지켜낼 때만'에 따라 이 조건 안에서만 살 수 있으므로 판정을 바꾸지 않는다. 그래서 별도 갈래로 두지 않았다(a의 독립 갈래는 회복 확인 전 반등을 진입·확인대기로 올리는 오류).",
    "all": [
     {
      "label": "지수 20일선 종가 회복 후 2거래일 유지(3일 연속 종가 > 20일선)",
      "ref": "2-2",
      "ge": [
       {
        "streak": {
         "gt": [
          {
           "px": "close",
           "sym": "$index"
          },
          {
           "ma": [
            {
             "px": "close",
             "sym": "$index"
            },
            20
           ]
          }
         ]
        }
       },
       3
      ]
     }
    ]
   },
   "avoid": {
    "def": "avoid_common"
   }
  },
  "IWM": {
   "index": "^RUT",
   "note": "2-3",
   "filter": {
    "all": [
     {
      "def": "idx_above_ma20"
     },
     {
      "def": "env_stable"
     }
    ]
   },
   "entry": {
    "all": [
     {
      "def": "idx_hold_ma20_2d",
      "ref": "2-3"
     },
     {
      "label": "대표 대형주 3개 이상 전일 대비 플러스(넓은 위험선호)",
      "ref": "2-3",
      "note": "대표 대형주 종목 선정은 운영 판단(저자 미특정): AAPL MSFT NVDA AMZN GOOGL",
      "ge": [
       {
        "across": {
         "syms": [
          "AAPL",
          "MSFT",
          "NVDA",
          "AMZN",
          "GOOGL"
         ],
         "cond": {
          "gt": [
           {
            "px": "close",
            "sym": "$s"
           },
           {
            "lag": [
             {
              "px": "close",
              "sym": "$s"
             },
             1
            ]
           }
          ]
         }
        }
       },
       3
      ]
     }
    ]
   },
   "avoid": {
    "def": "avoid_common"
   }
  }
 }
}