{
  "version": 1,
  "source": {"book": "trend", "extractor": "b",
             "sections_read": ["프롤로그", "1-1", "1-2", "1-3", "1-4", "1-5", "2-1", "2-2", "2-3", "2-4", "3-1", "3-2", "3-3", "에필로그"]},
  "defs": {
    "C": {"px": "close"},
    "IDX_ABOVE_MA20": {"label": "기준지수 종가 > 20일선", "ref": "2-1",
      "gt": [{"px": "close", "sym": "$index"}, {"ma": [{"px": "close", "sym": "$index"}, 20]}]},
    "IDX_HOLD_MA20_2D": {"label": "기준지수 20일선 종가 회복 후 2거래일 유지(회복일+2일 = 3일 연속 위)", "ref": "2-1",
      "ge": [{"streak": {"def": "IDX_ABOVE_MA20"}}, 3]},
    "ENV_STABLE": {"label": "아침 환경 점검: 선물·변동성·금리 셋 다 안정", "ref": "1-5",
      "all": [
        {"label": "개장 전 S&P500·나스닥 선물이 둘 다 전일 대비 마이너스가 아님", "ref": "1-1",
         "manual": "개장 전 선물 방향(ES=F·NQ=F) — 일봉으로 알 수 없음. 둘 다 마이너스면 참는다"},
        {"label": "VIX 전일 대비 +10% 이상 급등 아님", "ref": "1-2",
         "not": {"ge": [{"pct": [{"px": "close", "sym": "^VIX"}, 1]}, 10]}},
        {"label": "10년물 금리 급등 아님(하루 +0.1%p 초과 또는 2일 연속 상승이 아님)", "ref": "1-3",
         "not": {"any": [
           {"label": "10년물 하루 0.1%p 넘게 상승", "ref": "1-3",
            "gt": [{"sub": [{"px": "close", "sym": "^TNX"}, {"lag": [{"px": "close", "sym": "^TNX"}, 1]}]}, 0.1]},
           {"label": "10년물 이틀 연속 상승", "ref": "1-3",
            "ge": [{"streak": {"gt": [{"px": "close", "sym": "^TNX"}, {"lag": [{"px": "close", "sym": "^TNX"}, 1]}]}}, 2]}
         ]}}
      ]},
    "AVOID_COMMON": {"label": "공통 회피: 과열·털림 자리", "ref": "3-1",
      "any": [
        {"label": "최근 5거래일 20% 넘게 상승", "ref": "3-1",
         "gt": [{"pct": [{"px": "close"}, 5]}, 20]},
        {"label": "종가가 5일선에서 크게 벌어짐", "ref": "3-1",
         "manual": "저자 미명시: 5일선 이격 '크게'의 숫자 없음"},
        {"label": "고점 대비 종가 4% 이상 밀린 윗꼬리 마감", "ref": "3-2",
         "ge": [{"div": [{"sub": [{"px": "high"}, {"px": "close"}]}, {"px": "high"}]}, 0.04]},
        {"label": "거래량 전일 1.5배 이상 + 종가가 고점 아래로 밀림", "ref": "3-2",
         "all": [
           {"label": "거래량 전일 대비 1.5배 이상", "ref": "3-2",
            "ge": [{"div": [{"px": "volume"}, {"lag": [{"px": "volume"}, 1]}]}, 1.5]},
           {"label": "종가가 고점 아래로 밀림", "ref": "3-2",
            "manual": "저자 미명시: 고점 대비 얼마나 밀려야 하는지 숫자 없음"}
         ]}
      ]}
  },
  "products": {
    "SPY": {
      "index": "^GSPC",
      "note": "2-1 전고점 돌파 후 2거래일 버팀은 '비중을 키우기 좋은 자리'(추가매수)라 entry 에서 제외.",
      "filter": {"label": "SPY 전제", "ref": "2-1", "all": [
        {"def": "IDX_ABOVE_MA20", "label": "S&P500 종가 > 20일선", "ref": "2-1"},
        {"def": "ENV_STABLE", "label": "환경 셋 다 안정", "ref": "1-5"}
      ]},
      "entry": {"label": "SPY 진입", "ref": "2-1", "all": [
        {"def": "IDX_HOLD_MA20_2D", "label": "S&P500 20일선 회복 후 2거래일 유지", "ref": "2-1"}
      ]},
      "avoid": {"def": "AVOID_COMMON", "label": "공통 회피", "ref": "3-1"}
    },
    "QQQ": {
      "index": "^NDX",
      "filter": {"label": "QQQ 전제", "ref": "2-2", "all": [
        {"def": "IDX_ABOVE_MA20", "label": "나스닥100 종가 > 20일선", "ref": "2-2"},
        {"def": "ENV_STABLE", "label": "환경 셋 다 안정", "ref": "1-5"}
      ]},
      "entry": {"label": "QQQ 진입", "ref": "2-2", "all": [
        {"def": "IDX_HOLD_MA20_2D", "label": "나스닥100 20일선 회복 후 2거래일 유지", "ref": "2-2"},
        {"label": "강한 상승 뒤 2~4거래일 눌림 끝 반등", "ref": "2-2", "all": [
          {"label": "직전에 강한 상승", "ref": "2-2",
           "manual": "저자 미명시: '강한 상승'의 크기·기간 숫자 없음"},
          {"label": "오늘 반등(종가 > 전일 종가)", "ref": "2-2",
           "gt": [{"px": "close"}, {"lag": [{"px": "close"}, 1]}]},
          {"label": "어제까지 고점 이후 눌림 일수 2~4", "ref": "2-2",
           "note": "고점 = 최근 20거래일 최고 종가 — 창 길이 20은 저자 미명시, 운영 판단(20일선 체계에 맞춤). 대상은 매수 상품 QQQ 자체",
           "all": [
             {"ge": [{"lag": [{"barssince": {"ge": [{"px": "close"}, {"highest": [{"px": "close"}, 20]}]}}, 1]}, 2]},
             {"le": [{"lag": [{"barssince": {"ge": [{"px": "close"}, {"highest": [{"px": "close"}, 20]}]}}, 1]}, 4]}
           ]}
        ]}
      ]},
      "avoid": {"def": "AVOID_COMMON", "label": "공통 회피", "ref": "3-1"}
    },
    "IWM": {
      "index": "^RUT",
      "filter": {"label": "IWM 전제", "ref": "2-3", "all": [
        {"def": "IDX_ABOVE_MA20", "label": "러셀2000 종가 > 20일선", "ref": "2-3"},
        {"def": "ENV_STABLE", "label": "환경 셋 다 안정", "ref": "1-5"}
      ]},
      "entry": {"label": "IWM 진입", "ref": "2-3", "all": [
        {"def": "IDX_HOLD_MA20_2D", "label": "러셀2000 20일선 회복 후 2거래일 유지", "ref": "2-3"},
        {"label": "대표 대형주 3개 이상 같은 방향(전일 대비 플러스)", "ref": "2-3",
         "note": "대표 대형주 종목 선정(AAPL·MSFT·NVDA·AMZN·GOOGL)은 저자 미명시, 운영 판단. '같은 방향' = 플러스(1-4)",
         "ge": [{"across": {"syms": ["AAPL", "MSFT", "NVDA", "AMZN", "GOOGL"],
                            "cond": {"gt": [{"px": "close", "sym": "$s"}, {"lag": [{"px": "close", "sym": "$s"}, 1]}]}}}, 3]}
      ]},
      "avoid": {"def": "AVOID_COMMON", "label": "공통 회피", "ref": "3-1"}
    }
  }
}
