# ==== 비밀·크레덴셜 (절대 커밋 금지) ====
telegram.env
*.env
!*.env.example

# ==== 런타임 생성물 (매 실행마다 갱신) ====
# 책 산출물은 books/<slug>/ 한 곳 — playbook.html·source.md·source_index.json·tree.json·tree_candidates/·scenarios.json 은 커밋,
# 아래(백테스트 탭 데이터·책별 로그)는 실행마다 다시 만든다.
books/*/backtest.json
books/*/logs/
logs/

# ==== 배포 아티팩트 (public/은 별도 배포 레포) ====
public/

# ==== 파이썬/OS 잡파일 ====
__pycache__/
*.pyc
.DS_Store
.omc/
.venv/

# ==== 시세 데이터 캐시(jhts 가 생성 — 로컬 전용) ====
data/

# ==== 내 포지션(개인 정보 — 로컬 화면에서만 매도·분할 판정) ====
books/*/positions.json
